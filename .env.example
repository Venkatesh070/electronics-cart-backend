PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated allowlist — the admin panel and storefront are separate origins.
# Required in production (NODE_ENV=production); CORS fails closed if unset there.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Firebase Auth (Google, phone, email/password)
# Prefer service account JSON path, or set the three vars below.
FIREBASE_SERVICE_ACCOUNT_PATH=./electronics-cart-firebase-adminsdk-fbsvc-f33ed7b502.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n newlines escaped, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Web API key from Project settings → General (used for email/password login via Identity Toolkit)
FIREBASE_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → set the webhook URL to <host>/api/payments/razorpay/webhook
# and subscribe to payment.captured + payment.failed. Paste the secret shown there.
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_CURRENCY=INR
# Set true only for local/dev testing without a real Razorpay account
PAYMENTS_MOCK=false

# Shiprocket (Settings → API → API User email/password — not your seller login)
# In the seller dashboard: Channels → Manual (custom store) is enough; we push via API.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup location name from Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: skip the pickup-address API lookup for rate quotes by setting this directly
# (pincode of the pickup location above). Looked up + cached automatically if unset.
SHIPROCKET_PICKUP_PINCODE=
# Seller GSTIN — required for Shiprocket tax invoice / orders over ₹50,000 (e-way bill)
SHIPROCKET_GSTIN=
SHIPROCKET_COMPANY_NAME=Electronics Cart
# State of your pickup warehouse (for CGST+SGST vs IGST split)
SHIPROCKET_PICKUP_STATE=Telangana
# Default GST % and HSN when product.tax is unset (laptops ≈ 18%, HSN 8471)
SHIPROCKET_GST_RATE=18
SHIPROCKET_DEFAULT_HSN=84713000
# Optional package defaults (cm / used for courier rates)
# SHIPROCKET_BOX_LENGTH=45
# SHIPROCKET_BOX_BREADTH=35
# SHIPROCKET_BOX_HEIGHT=12
# Set true to skip live Shiprocket calls (fake AWB for local testing)
SHIPPING_MOCK=false
SHIPROCKET_WEBHOOK_SECRET=
# Warehouse address for reverse returns (optional — defaults to Shiprocket pickup location)
# SHIPROCKET_RETURN_NAME=Electronics Cart
# SHIPROCKET_RETURN_PHONE=
# SHIPROCKET_RETURN_ADDRESS=
# SHIPROCKET_RETURN_CITY=
# SHIPROCKET_RETURN_STATE=Telangana
# SHIPROCKET_RETURN_PINCODE=
# Optional: Shiprocket channel id for return orders
# SHIPROCKET_CHANNEL_ID=
