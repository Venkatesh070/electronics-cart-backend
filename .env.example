PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Firebase Auth (Google, phone, email/password)
# Prefer service account JSON path, or set the three vars below.
FIREBASE_SERVICE_ACCOUNT_PATH=./electronics-cart-firebase-adminsdk-fbsvc-f33ed7b502.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n newlines escaped, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Web API key from Project settings → General (used for email/password login via Identity Toolkit)
FIREBASE_API_KEY=
